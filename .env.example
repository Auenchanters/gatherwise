# Server-only Google AI Studio key. Never prefix secrets with VITE_.
GEMINI_API_KEY=
# Default model; override only with a model supporting structured JSON output.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional explicit production origin; requests otherwise require their own origin.
APP_ORIGIN=
# Shared rate limits and daily AI budget (Upstash Redis via the Vercel Marketplace). Without
# them the limits count in each instance's memory. The UPSTASH_REDIS_REST_* names work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Model calls allowed per UTC day across the deployment (default 300).
AI_DAILY_LIMIT=
