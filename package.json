{
  "name": "gatherwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A GenAI planning assistant for community events, weddings and birthdays: budgets that reconcile, timelines that respect lead times, vendor checklists and personalized ideas.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"tsx watch --env-file-if-exists=.env.local scripts/dev-server.ts\"",
    "build": "tsc -b && vite build && npm run test:bundle && npm run build:api && npm run test:runtime",
    "build:api": "tsc -p tsconfig.server.json",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:bundle": "tsx scripts/bundle-budget.ts",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-smoke.ts",
    "preflight": "tsx scripts/preflight.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run knip && npm run build && npm run format:check"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@hono/node-server": "2.1.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
